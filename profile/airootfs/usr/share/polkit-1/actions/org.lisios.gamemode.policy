<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dtds/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>LisiOS</vendor>
  <action id="org.lisios.gamemode.apply">
    <description>LisiOS Game Mode: change CPU priority of your own processes</description>
    <description xml:lang="ru">LisiOS Game Mode: изменение приоритета ваших процессов</description>
    <message>Authentication is required to change process priorities</message>
    <message xml:lang="ru">Для изменения приоритетов процессов нужна авторизация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/lisios/gamemode/helper.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
